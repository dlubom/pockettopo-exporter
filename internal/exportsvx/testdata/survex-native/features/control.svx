1.0 1.1 10.020 90 0
1.0 1.1 10.000 90 0
1.0 1.1 9.980 90 0
1.1 :: 2.500 0 0
*declination 4.998779 degrees
1.1 0 5.000 180 0
0 0.0 3.000 45 0
*declination 0 degrees
0.0 1.2 2.000 0 90
1.2 1.3 0.000 0 0
1.3 1.4 1.000 0 0
*end
